  <class name="logger" superclass="qpc::QActive">
   <attribute name="sdcard" type="QHsm *" visibility="0x02" properties="0x00"/>
   <attribute name="tickEvt" type="QTimeEvt" visibility="0x02" properties="0x00"/>
