     <state name="LOGGING_MODE">
      <entry>me-&gt;tick = 0U;</entry>
      <state name="LOGGING_INITIALIZING">
       <entry>QTimeEvt_disarm(&amp;me-&gt;tickEvt);
QTimeEvt_disarm(&amp;me-&gt;sdTickEvt);</entry>
       <exit>QTimeEvt_armX(&amp;me-&gt;tickEvt, CONFIG_LOGGER_TICK_INTERVAL_MS, CONFIG_LOGGER_TICK_INTERVAL_MS);
QTimeEvt_armX(&amp;me-&gt;sdTickEvt, CONFIG_SDCARD_TICK_INTERVAL_MS, CONFIG_SDCARD_TICK_INTERVAL_MS);</exit>
       <state name="INIT_FILESYSTEM">
        <entry>FRESULT res = fatfs_sd_mount();
if(res != FR_OK) {
    QS_BEGIN_ID(LOGGER_DEBUG_RECORD, (void *)0);
        QS_STR(&quot;mount failed!&quot;);
    QS_END();
    QEvt * pEvt = Q_NEW(QEvt, ERROR_SIG);
    QACTIVE_POST((QActive *)me, pEvt, me);
} else {
    QS_BEGIN_ID(LOGGER_DEBUG_RECORD, (void *)0);
        QS_STR(&quot;filesystem mounted&quot;);
    QS_END();

    /* Check &quot;logs&quot; directory */
    FILINFO fno;
    res = f_stat(&quot;logs&quot;, &amp;fno);

    if (res == FR_OK) {
        // Directory exists
        QS_BEGIN_ID(LOGGER_DEBUG_RECORD, (void *)0);
            QS_STR(&quot;directory found&quot;);
        QS_END();
        QEvt * pEvt = Q_NEW(QEvt, CREATE_LOGFILE_SIG);
        QACTIVE_POST((QActive *)me, pEvt, me);
    } else if (res == FR_NO_FILE) {
        // Directory does not exist, create the said directory
        QS_BEGIN_ID(LOGGER_DEBUG_RECORD, (void *)0);
            QS_STR(&quot;directory not found, creating...&quot;);
        QS_END();
        res = f_mkdir(&quot;logs&quot;);
        if(res == FR_OK) {
            QS_BEGIN_ID(LOGGER_DEBUG_RECORD, (void *)0);
                QS_STR(&quot;...sucess&quot;);
            QS_END();
            QEvt * pEvt = Q_NEW(QEvt, CREATE_LOGFILE_SIG);
            QACTIVE_POST((QActive *)me, pEvt, me);
        } else {
            QS_BEGIN_ID(LOGGER_DEBUG_RECORD, (void *)0);
                QS_STR(&quot;...fail&quot;);
            QS_END();
            QEvt * pEvt = Q_NEW(QEvt, ERROR_SIG);
            QACTIVE_POST((QActive *)me, pEvt, me);
        }
    } else {
        // An error occurred
        QS_BEGIN_ID(LOGGER_DEBUG_RECORD, (void *)0);
            QS_STR(&quot;Error: f_stat()&quot;);
        QS_END();
        QEvt * pEvt = Q_NEW(QEvt, ERROR_SIG);
        QACTIVE_POST((QActive *)me, pEvt, me);
    }
}
</entry>
        <tran trig="CREATE_LOGFILE" target="../../1">
         <tran_glyph conn="32,79,3,1,42,8,-3">
          <action box="0,-2,16,2"/>
         </tran_glyph>
        </tran>
        <state_glyph node="32,71,39,10">
         <entry box="0,3,6,2"/>
        </state_glyph>
       </state>
       <state name="CREATE_LOG_FILE">
        <entry>FRESULT res = FR_OK;
FILINFO fno;
bool hasError = false;

/* Check for index.bin */
res = f_stat(INDEX_FILE_PATH, &amp;fno);
if(res == FR_OK) {
    /* index.txt found */
    uint32_t index = 0;
    res = f_open(&amp;me-&gt;file, INDEX_FILE_PATH, FA_OPEN_ALWAYS | FA_WRITE | FA_READ);
    if(res == FR_OK) {
        UINT brw;
        res = f_read(&amp;me-&gt;file, &amp;index, 4, &amp;brw);
        if(res != FR_OK) {
            hasError = true;
        } else {
            index++;
            me-&gt;file_index = index;
            f_rewind(&amp;me-&gt;file);
            res = f_write(&amp;me-&gt;file, &amp;index, 4, &amp;brw);
            if(res != FR_OK) {
                hasError = true;
            }
        }
        f_close(&amp;me-&gt;file);
    }
} else if(res == FR_NO_FILE) {
    /* create index.txt */
    me-&gt;file_index = 0;
    res = f_open(&amp;me-&gt;file, INDEX_FILE_PATH, FA_OPEN_ALWAYS | FA_WRITE);
    if(res == FR_OK) {
        UINT bw;
        res = f_write(&amp;me-&gt;file, &amp;me-&gt;file_index, 4, &amp;bw);
        if(res != FR_OK) {
            hasError = true;
        }
        f_close(&amp;me-&gt;file);
    }
} else {
    /* some other error */
    hasError = true;
}

if(!hasError) {
    snprintf(me-&gt;logFilePath, sizeof(me-&gt;logFilePath), &quot;logs/CanLog_%010ld.bin&quot;, me-&gt;file_index);
    QEvt * pEvt = Q_NEW(QEvt, START_LOGGING_SIG);
    QACTIVE_POST((QActive *)me, pEvt, me);
} else {
    QEvt * pEvt = Q_NEW(QEvt, ERROR_SIG);
    QACTIVE_POST((QActive *)me, pEvt, me);
}</entry>
        <tran trig="START_LOGGING" target="../../../1">
         <tran_glyph conn="32,90,3,1,49,17,-4">
          <action box="0,-2,15,2"/>
         </tran_glyph>
        </tran>
        <state_glyph node="32,83,39,10">
         <entry box="0,3,6,2"/>
        </state_glyph>
       </state>
       <state_glyph color="2" node="27,63,50,33">
        <entry box="0,3,6,2"/>
        <exit box="0,5,6,2"/>
       </state_glyph>
      </state>
      <state name="LOGGING_ACTIVE">
       <entry>(void)BSP_CAN_register_cb(CAN_ONE, me, can_one_rx_callback);
(void)BSP_CAN_start(CAN_ONE);

FRESULT res = f_open(&amp;me-&gt;file, me-&gt;logFilePath, FA_OPEN_APPEND | FA_WRITE);
if(res != FR_OK) {
    me-&gt;logFileOpen = false;
    QS_BEGIN_ID(LOGGER_DEBUG_RECORD, (void *)0);
        QS_STR(&quot;failed to open log file!&quot;);
    QS_END();
    QEvt * pEvt = Q_NEW(QEvt, ERROR_SIG);
    QACTIVE_POST((QActive *)me, pEvt, me);
} else {
    me-&gt;logFileOpen = true;
    QS_BEGIN_ID(LOGGER_DEBUG_RECORD, (void *)0);
        QS_STR(me-&gt;logFilePath);
    QS_END();
}</entry>
       <exit>(void)BSP_CAN_stop(CAN_ONE);
me-&gt;logFileOpen = false;
f_close(&amp;me-&gt;file);</exit>
       <tran trig="LOGGER_TICK">
        <action>me-&gt;tick += CONFIG_LOGGER_TICK_INTERVAL_MS;</action>
        <choice target="../../../../8">
         <guard brief="usb_connect">tud_connected() &amp;&amp; !tud_suspended()</guard>
         <choice_glyph conn="43,112,5,1,47,33,-6">
          <action box="1,-2,14,2"/>
         </choice_glyph>
        </choice>
        <choice>
         <guard>else</guard>
         <choice_glyph conn="43,112,4,-1,4,8">
          <action box="1,2,10,2"/>
         </choice_glyph>
        </choice>
        <tran_glyph conn="27,112,3,-1,16">
         <action box="0,-2,15,2"/>
        </tran_glyph>
       </tran>
       <tran trig="CAN_RECEIVE">
        <action>uint32_t bw = 0;
const FRESULT res = f_write(&amp;me-&gt;file, 
            Q_EVT_CAST(WriteLogEvt)-&gt;buff,
            Q_EVT_CAST(WriteLogEvt)-&gt;bufLen, (UINT*)&amp;bw);

if(res != FR_OK) {
    QEvt * pEvt = Q_NEW(QEvt, ERROR_SIG);
    QACTIVE_POST((QActive *)me, pEvt, me);
}</action>
        <tran_glyph conn="27,120,3,-1,16">
         <action box="0,-2,13,2"/>
        </tran_glyph>
       </tran>
       <state_glyph color="2" node="27,103,50,23">
        <entry box="0,3,6,2"/>
        <exit box="0,5,6,2"/>
       </state_glyph>
      </state>
      <state_glyph color="1" node="19,57,65,74">
       <entry box="0,3,6,2"/>
      </state_glyph>
     </state>
     <state name="USB_MSC_MODE">
      <entry>me-&gt;tick = 0U;</entry>
      <tran trig="LOGGER_TICK">
       <action>me-&gt;tick += CONFIG_LOGGER_TICK_INTERVAL_MS;</action>
       <choice target="../../../7/1">
        <guard brief="usb_disconnect">tud_suspended()</guard>
        <choice_glyph conn="35,150,5,1,57,-40,-15">
         <action box="1,-2,14,2"/>
        </choice_glyph>
       </choice>
       <choice>
        <guard>else</guard>
        <choice_glyph conn="35,150,4,-1,3,8">
