QS_FUN_DICTIONARY(&amp;logger_LOGGING_ACTIVE);
QS_FUN_DICTIONARY(&amp;logger_USB_MSC_MODE);

me-&gt;logFileOpen = false;
memset(me-&gt;logFilePath, 0, sizeof(me-&gt;logFilePath));

QTimeEvt_ctorX(&amp;me-&gt;tickEvt, &amp;me-&gt;super, LOGGER_TICK_SIG, 0U);
QTimeEvt_ctorX(&amp;me-&gt;sdTickEvt, &amp;me-&gt;super, SDCARD_TICK_SIG, 0U);

/* Inital transition of component */
QHSM_INIT(me-&gt;sdcard, (QEvt*)0, 0);</action>
