        </choice_glyph>
       </choice>
       <tran_glyph conn="19,150,3,-1,16">
        <action box="0,-2,14,2"/>
       </tran_glyph>
      </tran>
      <state_glyph color="1" node="19,139,65,20">
       <entry box="0,3,6,2"/>
      </state_glyph>
     </state>
     <state name="ERROR">
      <state_glyph color="1" node="30,169,47,8"/>
     </state>
     <state_glyph node="15,20,83,163">
      <entry box="0,3,6,2"/>
     </state_glyph>
    </state>
    <state_diagram size="114,189"/>
   </statechart>
  </class>
  <attribute name="AO_logger" type="QActive * const" visibility="0x00" properties="0x00">
   <code>= &amp;(l_logger.super);</code>
  </attribute>
  <operation name="LOGGER_ctor" type="bool" visibility="0x00" properties="0x00">
   <code>static bool bInit = false;
static const int8_t taskName[] = &quot;LOGGER&quot;;

if(bInit == true) {
    return true;
}

logger * const me = &amp;l_logger;

/* Call constructor */
QActive_ctor(&amp;me-&gt;super, Q_STATE_CAST(&amp;logger_initial));
me-&gt;sdcard = sdcard_ctor((QActive *)me);

/* Create AO task */
QActive_setAttr(AO_logger, TASK_NAME_ATTR, taskName);
QACTIVE_START(
        AO_logger,
        CONFIG_LOGGER_AO_PRIO,
        l_loggerQSto,
        Q_DIM(l_loggerQSto),
        loggerStack,
        sizeof(loggerStack),
        (QEvt *)0
        );
bInit = true;

return true;</code>
  </operation>
  <operation name="can_one_rx_callback" type="void" visibility="0x02" properties="0x00">
   <parameter name="obj" type="void *"/>
   <parameter name="pPacket" type="CAN_RX_T *"/>
   <code>if((obj != NULL) &amp;&amp; (pPacket != NULL)) {
    logger * const me = (logger *)obj;
    const uint8_t channel = 0; // CAN1
    const bool isTx = false; // receive
    const bool isCanFd = (pPacket-&gt;header.FDFormat == FDCAN_FD_CAN) ? true : false;
    const uint32_t msgId = pPacket-&gt;header.Identifier;
    const uint8_t dlc = DLC_TO_BYTES[pPacket-&gt;header.DataLength];

    WriteLogEvt * pEvt = Q_NEW(WriteLogEvt, CAN_RECEIVE_SIG);
    pEvt-&gt;bufLen = FRAME_format_can(channel, isTx, isCanFd,
                       pEvt-&gt;buff, MAX_FRAME_LEN, msgId, dlc,
                       pPacket-&gt;data);
    QACTIVE_POST((QActive *)me, (QEvt *)pEvt, me);
}</code>
  </operation>
  <directory name="inc">
   <file name="logger.h">
    <text>#ifndef LOGGER_H
#define LOGGER_H

#include &quot;qpc.h&quot;
#include &quot;logger_frame.h&quot;
#include &quot;bsp_can.h&quot;

$declare(logger::event::WriteLogEvt)

$declare(logger::AO_logger)

$declare(logger::LOGGER_ctor)

#endif /* LOGGER_H */
</text>
   </file>
  </directory>
  <directory name="src">
   <file name="logger.c">
    <text>#include &quot;qpc.h&quot;
#include &quot;appPubList.h&quot;
#include &quot;sdcard.h&quot;
#include &quot;tusb.h&quot;
#include &quot;ff.h&quot;
#include &quot;../inc/logger.h&quot;
#include &quot;../inc/logger_frame.h&quot;
#include &quot;fatfs_sd.h&quot;

Q_DEFINE_THIS_MODULE(&quot;logger.c&quot;)

#define CONFIG_LOGGER_AO_PRIO              (2)
#define CONFIG_LOGGER_AO_EVENT_QUEUE_LEN   (10)
#define CONFIG_LOGGER_AO_STACK             (512)
#define CONFIG_LOGGER_TICK_INTERVAL_MS     (10)
#define CONFIG_SDCARD_TICK_INTERVAL_MS     (10)

#define INDEX_FILE_PATH                    &quot;logs/index.bin&quot;

enum loggerSignal {
    LOGGER_TICK_SIG = MAX_PUB_SIG,
    SDCARD_TICK_SIG,
    CREATE_LOGFILE_SIG,
    START_LOGGING_SIG,
    CAN_RECEIVE_SIG,
    ERROR_SIG,
};

enum loggerTraceRecord {
    LOGGER_DEBUG_RECORD = QS_USER,
};

const uint8_t DLC_TO_BYTES[16] = {0, 1, 2, 3, 4, 5, 6, 7, 8, 12,
                    16, 20, 24, 32, 48, 64};

$declare(logger::sdcard::sdcard)
$declare(logger::logger)

/*
 * Local object
 */
static sdcard l_sdcard;
static logger l_logger;
static QEvt const * l_loggerQSto[CONFIG_LOGGER_AO_EVENT_QUEUE_LEN];
static StackType_t loggerStack[CONFIG_LOGGER_AO_STACK];

$define(logger::AO_logger)

$define(logger::can_one_rx_callback)

$define(logger::sdcard::sdcard_ctor)
$define(logger::LOGGER_ctor)

$define(logger::sdcard::sdcard)
$define(logger::logger)
</text>
   </file>
  </directory>
 </package>
 <directory name=".">
  <file name="appPubList.h">
   <text>#ifndef APP_PUB_LIST_H
#define APP_PUB_LIST_H

enum PublicSignals {
    /* Common Event across AO */
    GET_OBJECT_DICTIONARY_SIG = Q_USER_SIG,
    GET_FUNC_DICTIONARY_SIG,
    GET_SIGNAL_DICTIONARY_SIG,

    /* Published Events */


    MAX_PUB_SIG    /* Last Published Signal.  This is also the start of AO specific signals */
};

#endif /* APP_PUB_LIST_H */
