     <state name="INITIALIZING">
      <entry>me-&gt;tick = 0U;</entry>
      <tran trig="LOGGER_TICK">
       <action>me-&gt;tick += CONFIG_LOGGER_TICK_INTERVAL_MS;</action>
       <choice target="../../../7/0/0">
        <guard brief="sd_ready">SDCARD_InitDone() &amp;&amp; SDCARD_ready()</guard>
        <choice_glyph conn="34,47,5,1,53,28,-16">
         <action box="1,-2,10,2"/>
