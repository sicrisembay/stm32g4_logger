    </initial>
    <state name="TOP">
     <entry>/* arm periodic tick timer */
QTimeEvt_armX(&amp;me-&gt;tickEvt, CONFIG_LOGGER_TICK_INTERVAL_MS, CONFIG_LOGGER_TICK_INTERVAL_MS);
QTimeEvt_armX(&amp;me-&gt;sdTickEvt, CONFIG_SDCARD_TICK_INTERVAL_MS, CONFIG_SDCARD_TICK_INTERVAL_MS);
me-&gt;tick = 0;</entry>
