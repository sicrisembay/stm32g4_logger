   <statechart properties="0x00">
    <initial target="../1">
     <action>QS_OBJ_DICTIONARY(&amp;l_logger);

QS_FUN_DICTIONARY(&amp;logger_initial);
QS_FUN_DICTIONARY(&amp;logger_TOP);
QS_FUN_DICTIONARY(&amp;logger_INITIALIZING);
